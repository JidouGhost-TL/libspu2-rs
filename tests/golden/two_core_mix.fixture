# Voice on each core; core 1 enabled so AVOL mixing path is exercised.
reset
ram_file 5000 data/sine440_loop.bin
reg 0 19A 8000
reg 1 19A 8000
reg 0 000 3FFF
reg 0 002 3FFF
reg 0 004 1000
reg 0 006 000F
reg 0 1C0 0000
reg 0 1C2 2800
reg 1 000 3FFF
reg 1 002 3FFF
reg 1 004 0800
reg 1 006 000F
reg 1 1C0 0000
reg 1 1C2 2800
reg 0 1A0 0001
reg 1 1A0 0001
render 24000
